{
  "name": "@aluzina/hub",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tokens": "node --experimental-strip-types scripts/gen-tokens.mjs",
    "typecheck": "tsc --noEmit",
